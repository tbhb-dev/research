{
  "language": "en",
  "ignorePaths": [
    ".mise/**/*",
    ".rumdl_cache/**/*",
    ".vale/**/*",
    ".venv/**/*",
    "bazel-*/**/*",
    ".bazel-*/**/*",
    "coverage.xml",
    "MODULE.bazel.lock",
    "mise.lock",
    "tmp/**/*",
    // A verbatim copy of ascm's scripts, linted at the source in ascm.
    "tools/interim/**/*",
    "uv.lock"
  ],
  "dictionaryDefinitions": [
    {
      "name": "tbhbresearch",
      "path": "./.cspell-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": ["tbhbresearch", "python"]
}
